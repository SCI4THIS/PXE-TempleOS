# start.sh stores the live configuration at:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/rpi3b-pxe/config.env
#
# These are the first-run defaults.
PXE_SERVER_IP=192.168.1.68
PXE_NETWORK=192.168.1.0/24
EXPORT_RO=/mnt/ssd/exports/ro
EXPORT_RW=/mnt/ssd/exports/rw
BACKUP_DIR=/mnt/ssd/bkup
SAMBA_ROOT=/mnt/ssd/exports/rw/samba
ENABLE_SAMBA=0
OMARCHY_NFS_BUILD_EXPORT=0
OMARCHY_VERSION=4.0.1
